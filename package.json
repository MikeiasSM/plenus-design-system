{
  "name": "@plenustech/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Design System centralizado para os produtos web da Plenustech.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "preview:showcase": "vite preview --config showcase/vite.config.ts"
  },
  "dependencies": {
    "@react-aria/focus": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}

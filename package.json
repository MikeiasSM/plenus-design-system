{
  "name": "@plenustech/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Design System centralizado para os produtos web da Plenustech.",
  "type": "module",
  "main": "./dist/plenus-design-system.cjs",
  "module": "./dist/plenus-design-system.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/plenus-design-system.es.js",
      "require": "./dist/plenus-design-system.cjs"
    },
    "./styles.css": "./dist/design-system.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:showcase": "vite --config showcase/vite.config.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.build.json",
    "build:showcase": "vite build --config showcase/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "preview:showcase": "vite preview --config showcase/vite.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
